---
import { storyblokEditable } from '@storyblok/astro';

interface Props {
  blok: {
    section_title?: string;
    section_copy?: string;
    tabs?: any[];
  };
}

const { blok } = Astro.props;
---

<section class="tabbed-demo" {...storyblokEditable(blok)}>
  <div class="tabbed-demo__container">
    <div class="tabbed-demo__header">
      {blok.section_title && <h2 class="tabbed-demo__title">{blok.section_title}</h2>}
      {blok.section_copy && <p class="tabbed-demo__copy">{blok.section_copy}</p>}
    </div>

    <div class="tabbed-demo__tabs-wrapper">
      <div class="tabbed-demo__tabs" role="tablist">
        {blok.tabs?.map((tab: any, index: number) => (
          <button
            class:list={['tabbed-demo__tab', { active: index === 0 }]}
            role="tab"
            data-tab={tab.tab_id}
            aria-selected={index === 0 ? 'true' : 'false'}
          >
            {tab.tab_label}
          </button>
        ))}
      </div>

      <div class="tabbed-demo__panels">
        {blok.tabs?.map((tab: any, index: number) => (
          <div
            class:list={['tabbed-demo__panel', { active: index === 0 }]}
            role="tabpanel"
            data-panel={tab.tab_id}
            {...storyblokEditable(tab)}
          >
            <div class="tabbed-demo__panel-content">
              <h3 class="tabbed-demo__panel-headline">{tab.headline}</h3>
              <p class="tabbed-demo__panel-copy">{tab.copy}</p>
            </div>
            <div class="tabbed-demo__panel-visual">
              {tab.tab_id === 'chat' && (
                <div class="tabbed-demo__chat-demo">
                  <div class="tabbed-demo__chat-message tabbed-demo__chat-message--user">
                    Create a customer list with filters for status and date
                  </div>
                  <div class="tabbed-demo__chat-message tabbed-demo__chat-message--ai">
                    <div class="tabbed-demo__chat-ai-header">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 2L9 9L2 12L9 15L12 22L15 15L22 12L15 9L12 2Z"/>
                      </svg>
                      Creating CustomerResource with filters...
                    </div>
                    <pre class="tabbed-demo__chat-code"><code>class CustomerResource extends Resource
&#123;
    protected static ?string $model = Customer::class;
&#125;</code></pre>
                  </div>
                </div>
              )}
              {tab.tab_id === 'visual' && (
                <div class="tabbed-demo__visual-demo">
                  <div class="tabbed-demo__visual-sidebar">
                    <div class="tabbed-demo__visual-component">Table</div>
                    <div class="tabbed-demo__visual-component">Form</div>
                    <div class="tabbed-demo__visual-component">Chart</div>
                  </div>
                  <div class="tabbed-demo__visual-canvas">
                    <div class="tabbed-demo__visual-widget tabbed-demo__visual-widget--stats">
                      <div class="tabbed-demo__visual-stat">
                        <span class="tabbed-demo__visual-stat-value">$124K</span>
                        <span class="tabbed-demo__visual-stat-label">Revenue</span>
                      </div>
                    </div>
                  </div>
                </div>
              )}
              {tab.tab_id === 'code' && (
                <div class="tabbed-demo__code-demo">
                  <div class="tabbed-demo__code-header">
                    <span class="tabbed-demo__code-filename">CustomerResource.php</span>
                  </div>
                  <pre class="tabbed-demo__code-content"><code><span class="tabbed-demo__code-keyword">namespace</span> App\Filament\Resources;

<span class="tabbed-demo__code-keyword">class</span> <span class="tabbed-demo__code-class">CustomerResource</span> <span class="tabbed-demo__code-keyword">extends</span> Resource
&#123;
    <span class="tabbed-demo__code-comment">// Your code, your rules</span>
&#125;</code></pre>
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .tabbed-demo { padding: var(--spacing-24) 0; background: var(--color-bg-secondary); }
  .tabbed-demo__container { max-width: var(--max-width); margin: 0 auto; padding: 0 var(--spacing-6); }
  .tabbed-demo__header { text-align: center; margin-bottom: var(--spacing-12); }
  .tabbed-demo__title { font-size: var(--font-size-4xl); font-weight: var(--font-weight-light); margin-bottom: var(--spacing-4); }
  .tabbed-demo__copy { font-size: var(--font-size-lg); color: var(--color-text-secondary); max-width: 700px; margin: 0 auto; line-height: var(--line-height-relaxed); }
  .tabbed-demo__tabs-wrapper { background: var(--color-bg-primary); border: 1px solid var(--color-border); border-radius: var(--radius-lg); overflow: hidden; }
  .tabbed-demo__tabs { display: flex; border-bottom: 1px solid var(--color-border); }
  .tabbed-demo__tab { flex: 1; padding: var(--spacing-4) var(--spacing-6); background: transparent; border: none; font-family: var(--font-family); font-size: var(--font-size-sm); font-weight: var(--font-weight-medium); color: var(--color-text-secondary); cursor: pointer; transition: all var(--transition-fast); text-transform: uppercase; letter-spacing: 0.05em; position: relative; }
  .tabbed-demo__tab:hover { color: var(--color-text-primary); background: var(--color-bg-secondary); }
  .tabbed-demo__tab.active { color: var(--color-accent); background: var(--color-bg-secondary); }
  .tabbed-demo__tab.active::after { content: ''; position: absolute; bottom: -1px; left: 0; right: 0; height: 2px; background: var(--color-accent); }
  .tabbed-demo__panel { display: none; }
  .tabbed-demo__panel.active { display: grid; grid-template-columns: 1fr 1fr; gap: var(--spacing-8); padding: var(--spacing-8); }
  .tabbed-demo__panel-content { display: flex; flex-direction: column; justify-content: center; }
  .tabbed-demo__panel-headline { font-size: var(--font-size-2xl); font-weight: var(--font-weight-medium); margin-bottom: var(--spacing-4); }
  .tabbed-demo__panel-copy { font-size: var(--font-size-base); color: var(--color-text-secondary); line-height: var(--line-height-relaxed); }
  .tabbed-demo__panel-visual { background: var(--color-bg-secondary); border: 1px solid var(--color-border); border-radius: var(--radius-md); overflow: hidden; }
  .tabbed-demo__chat-demo { padding: var(--spacing-4); display: flex; flex-direction: column; gap: var(--spacing-4); }
  .tabbed-demo__chat-message { padding: var(--spacing-3) var(--spacing-4); border-radius: var(--radius-md); font-size: var(--font-size-sm); }
  .tabbed-demo__chat-message--user { background: var(--color-bg-tertiary); align-self: flex-end; max-width: 80%; }
  .tabbed-demo__chat-message--ai { background: rgba(94, 234, 212, 0.1); border: 1px solid rgba(94, 234, 212, 0.2); }
  .tabbed-demo__chat-ai-header { display: flex; align-items: center; gap: var(--spacing-2); color: var(--color-accent); font-weight: var(--font-weight-medium); margin-bottom: var(--spacing-3); }
  .tabbed-demo__chat-code { background: var(--color-bg-primary); padding: var(--spacing-3); border-radius: var(--radius-sm); font-family: var(--font-family-mono); font-size: var(--font-size-xs); overflow-x: auto; margin: 0; }
  .tabbed-demo__visual-demo { display: grid; grid-template-columns: 100px 1fr; min-height: 200px; }
  .tabbed-demo__visual-sidebar { padding: var(--spacing-3); border-right: 1px solid var(--color-border); display: flex; flex-direction: column; gap: var(--spacing-2); }
  .tabbed-demo__visual-component { padding: var(--spacing-2); background: var(--color-bg-tertiary); border-radius: var(--radius-sm); font-size: var(--font-size-xs); color: var(--color-text-muted); text-align: center; }
  .tabbed-demo__visual-canvas { padding: var(--spacing-4); }
  .tabbed-demo__visual-widget { background: var(--color-bg-tertiary); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--spacing-4); }
  .tabbed-demo__visual-stat { text-align: center; }
  .tabbed-demo__visual-stat-value { display: block; font-size: var(--font-size-xl); font-weight: var(--font-weight-semibold); color: var(--color-text-primary); }
  .tabbed-demo__visual-stat-label { font-size: var(--font-size-xs); color: var(--color-text-muted); }
  .tabbed-demo__code-demo { font-family: var(--font-family-mono); }
  .tabbed-demo__code-header { padding: var(--spacing-3) var(--spacing-4); background: var(--color-bg-tertiary); border-bottom: 1px solid var(--color-border); }
  .tabbed-demo__code-filename { font-size: var(--font-size-xs); color: var(--color-text-secondary); }
  .tabbed-demo__code-content { padding: var(--spacing-4); font-size: var(--font-size-xs); line-height: 1.6; overflow-x: auto; margin: 0; }
  .tabbed-demo__code-keyword { color: #c678dd; }
  .tabbed-demo__code-class { color: #e5c07b; }
  .tabbed-demo__code-comment { color: #5c6370; }
  @media (max-width: 768px) {
    .tabbed-demo__panel.active { grid-template-columns: 1fr; }
  }
</style>

<script>
  const tabs = document.querySelectorAll('.tabbed-demo__tab');
  const panels = document.querySelectorAll('.tabbed-demo__panel');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const targetId = tab.getAttribute('data-tab');
      tabs.forEach(t => { t.classList.remove('active'); t.setAttribute('aria-selected', 'false'); });
      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');
      panels.forEach(panel => {
        panel.classList.remove('active');
        if (panel.getAttribute('data-panel') === targetId) { panel.classList.add('active'); }
      });
    });
  });
</script>
