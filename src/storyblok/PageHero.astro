---
import { storyblokEditable } from '@storyblok/astro';

interface Props {
  blok: {
    headline?: string;
    subheadline?: string;
  };
}

const { blok } = Astro.props;
---

<section class="page-hero noise-bg" {...storyblokEditable(blok)}>
  <div class="page-hero__gradient-orb" aria-hidden="true"></div>
  <div class="page-hero__container">
    {blok.headline && <h1 class="page-hero__headline">{blok.headline}</h1>}
    {blok.subheadline && <p class="page-hero__subheadline">{blok.subheadline}</p>}
  </div>
</section>

<style>
  .page-hero {
    padding: var(--spacing-32) var(--spacing-6) var(--spacing-16);
    text-align: center;
    background: linear-gradient(180deg, var(--color-bg-primary) 0%, var(--color-bg-secondary) 100%);
    position: relative;
    overflow: hidden;
  }

  .page-hero__gradient-orb {
    position: absolute;
    top: -100px;
    right: -100px;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(238, 71, 35, 0.08) 0%, transparent 70%);
    filter: blur(60px);
    pointer-events: none;
    z-index: 0;
  }

  .page-hero__container {
    max-width: var(--max-width-narrow);
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .page-hero__headline {
    font-size: var(--font-size-5xl);
    font-weight: var(--font-weight-light);
    line-height: var(--line-height-tight);
    margin-bottom: var(--spacing-6);
  }

  .page-hero__subheadline {
    font-size: var(--font-size-xl);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
  }

  @media (max-width: 768px) {
    .page-hero__headline {
      font-size: var(--font-size-3xl);
    }

    .page-hero__subheadline {
      font-size: var(--font-size-lg);
    }
  }
</style>
