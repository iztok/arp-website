---
import { storyblokEditable, StoryblokComponent } from '@storyblok/astro';

interface Props {
  blok: {
    headline?: string;
    badges?: any[];
    note?: string;
    logos?: any[];
  };
}

const { blok } = Astro.props;
---

<section class="logo-bar" {...storyblokEditable(blok)}>
  <div class="logo-bar__container">
    {blok.headline && <p class="logo-bar__headline">{blok.headline}</p>}

    {blok.badges && blok.badges.length > 0 && (
      <div class="logo-bar__badges">
        {blok.badges.map((badge: any) => (
          <span class="logo-bar__badge">
            <svg class="logo-bar__badge-icon" viewBox="0 0 20 20" fill="currentColor" width="16" height="16">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            {badge.label}
          </span>
        ))}
      </div>
    )}

    {blok.note && <p class="logo-bar__note">{blok.note}</p>}

    <div class="logo-bar__grid">
      {blok.logos && blok.logos.length > 0 ? (
        blok.logos.map((logo: any) => (
          <div class="logo-bar__logo-cell">
            {logo.logo?.filename ? (
              <img src={logo.logo.filename} alt={logo.name || 'Partner'} class="logo-bar__logo-img" />
            ) : (
              <span class="logo-bar__logo-placeholder">{logo.name || 'Partner'}</span>
            )}
          </div>
        ))
      ) : (
        Array.from({ length: 6 }).map((_, i) => (
          <div class="logo-bar__logo-cell">
            <span class="logo-bar__logo-placeholder">Partner {i + 1}</span>
          </div>
        ))
      )}
    </div>
  </div>
</section>

<style>
  .logo-bar {
    padding: var(--spacing-16) 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .logo-bar__container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--spacing-6);
    text-align: center;
  }

  .logo-bar__headline {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-6);
  }

  .logo-bar__badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--spacing-4);
    margin-bottom: var(--spacing-6);
  }

  .logo-bar__badge {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-2);
    padding: var(--spacing-2) var(--spacing-3);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-secondary);
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .logo-bar__badge-icon {
    color: var(--color-accent);
  }

  .logo-bar__note {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-8);
  }

  .logo-bar__grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .logo-bar__logo-cell {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-6);
    border-right: 1px solid var(--color-border);
    transition: background-color var(--transition-fast);
  }

  .logo-bar__logo-cell:last-child {
    border-right: none;
  }

  .logo-bar__logo-cell:hover {
    background-color: var(--color-bg-secondary);
  }

  .logo-bar__logo-img {
    max-height: 40px;
    width: auto;
    filter: grayscale(100%) brightness(0.8);
    opacity: 0.7;
    transition: all var(--transition-fast);
  }

  .logo-bar__logo-cell:hover .logo-bar__logo-img {
    filter: grayscale(0%);
    opacity: 1;
  }

  .logo-bar__logo-placeholder {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    opacity: 0.5;
  }

  @media (max-width: 1024px) {
    .logo-bar__grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .logo-bar__logo-cell:nth-child(3n) {
      border-right: none;
    }

    .logo-bar__logo-cell:nth-child(n+4) {
      border-top: 1px solid var(--color-border);
    }
  }

  @media (max-width: 640px) {
    .logo-bar__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .logo-bar__logo-cell:nth-child(3n) {
      border-right: 1px solid var(--color-border);
    }

    .logo-bar__logo-cell:nth-child(2n) {
      border-right: none;
    }

    .logo-bar__logo-cell:nth-child(n+3) {
      border-top: 1px solid var(--color-border);
    }
  }
</style>
