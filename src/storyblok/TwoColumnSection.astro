---
import { storyblokEditable } from '@storyblok/astro';

interface Props {
  blok: {
    headline?: string;
    left_title?: string;
    left_items?: any[];
    right_title?: string;
    right_items?: any[];
  };
}

const { blok } = Astro.props;
---

<section class="two-column" {...storyblokEditable(blok)}>
  <div class="two-column__container">
    {blok.headline && <h2 class="two-column__headline">{blok.headline}</h2>}

    <div class="two-column__grid">
      <div class="two-column__column">
        {blok.left_title && <h3 class="two-column__title">{blok.left_title}</h3>}
        <ul class="two-column__list">
          {blok.left_items?.map((item: any) => (
            <li class="two-column__item">
              <svg class="two-column__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              {item.text}
            </li>
          ))}
        </ul>
      </div>

      <div class="two-column__column">
        {blok.right_title && <h3 class="two-column__title">{blok.right_title}</h3>}
        <ul class="two-column__list">
          {blok.right_items?.map((item: any) => (
            <li class="two-column__item">
              <svg class="two-column__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              {item.text}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .two-column { padding: var(--spacing-24) 0; background: var(--color-bg-secondary); }
  .two-column__container { max-width: var(--max-width); margin: 0 auto; padding: 0 var(--spacing-6); }
  .two-column__headline { font-size: var(--font-size-4xl); font-weight: var(--font-weight-light); text-align: center; margin-bottom: var(--spacing-12); }
  .two-column__grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--spacing-8); }
  .two-column__column { background: var(--color-bg-card); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--spacing-8); box-shadow: var(--shadow-card); }
  .two-column__title { font-size: var(--font-size-lg); font-weight: var(--font-weight-medium); margin-bottom: var(--spacing-6); padding-bottom: var(--spacing-4); border-bottom: 1px solid var(--color-border); }
  .two-column__list { list-style: none; display: flex; flex-direction: column; gap: var(--spacing-3); }
  .two-column__item { display: flex; align-items: flex-start; gap: var(--spacing-3); font-size: var(--font-size-sm); color: var(--color-text-secondary); }
  .two-column__icon { width: 18px; height: 18px; color: var(--color-accent); flex-shrink: 0; margin-top: 2px; }
  @media (max-width: 768px) { .two-column__grid { grid-template-columns: 1fr; } }
</style>
