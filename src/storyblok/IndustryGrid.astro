---
import { storyblokEditable } from '@storyblok/astro';

interface Props {
  blok: {
    headline?: string;
    industries?: any[];
  };
}

const { blok } = Astro.props;
---

<section class="industry-grid" {...storyblokEditable(blok)}>
  <div class="industry-grid__container">
    {blok.headline && <h2 class="industry-grid__headline">{blok.headline}</h2>}

    <div class="industry-grid__grid">
      {blok.industries?.map((industry: any) => (
        <div class="industry-grid__card" {...storyblokEditable(industry)}>
          <h3 class="industry-grid__card-title">{industry.name}</h3>
          <ul class="industry-grid__card-list">
            {industry.items?.map((item: any) => (
              <li>{item.text}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .industry-grid { padding: var(--spacing-24) 0; background: var(--color-bg-secondary); }
  .industry-grid__container { max-width: var(--max-width); margin: 0 auto; padding: 0 var(--spacing-6); }
  .industry-grid__headline { font-size: var(--font-size-4xl); font-weight: var(--font-weight-light); text-align: center; margin-bottom: var(--spacing-12); }
  .industry-grid__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--spacing-6); }
  .industry-grid__card { background: var(--color-bg-primary); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--spacing-6); transition: border-color var(--transition-fast); }
  .industry-grid__card:hover { border-color: var(--color-border-light); }
  .industry-grid__card-title { font-size: var(--font-size-lg); font-weight: var(--font-weight-medium); margin-bottom: var(--spacing-4); color: var(--color-accent); }
  .industry-grid__card-list { list-style: none; display: flex; flex-direction: column; gap: var(--spacing-2); }
  .industry-grid__card-list li { font-size: var(--font-size-sm); color: var(--color-text-secondary); padding-left: var(--spacing-4); position: relative; }
  .industry-grid__card-list li::before { content: '•'; position: absolute; left: 0; color: var(--color-text-muted); }
  @media (max-width: 1024px) { .industry-grid__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .industry-grid__grid { grid-template-columns: 1fr; } }
</style>
