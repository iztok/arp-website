---
import { storyblokEditable } from '@storyblok/astro';

interface Props {
  blok: {
    headline?: string;
    left_title?: string;
    left_items?: any[];
    right_title?: string;
    right_items?: any[];
    cta_text?: string;
    cta_link?: { url?: string; cached_url?: string };
  };
}

const { blok } = Astro.props;
const ctaHref = blok.cta_link?.cached_url || blok.cta_link?.url || '#';
---

<section class="comparison" {...storyblokEditable(blok)}>
  <div class="comparison__container">
    {blok.headline && <h2 class="comparison__headline">{blok.headline}</h2>}

    <div class="comparison__columns">
      <div class="comparison__column comparison__column--left">
        {blok.left_title && <h3 class="comparison__column-title">{blok.left_title}</h3>}
        <ul class="comparison__list">
          {blok.left_items?.map((item: any) => (
            <li class="comparison__item comparison__item--negative">
              <svg class="comparison__item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="18" y1="6" x2="6" y2="18"/>
                <line x1="6" y1="6" x2="18" y2="18"/>
              </svg>
              {item.text}
            </li>
          ))}
        </ul>
      </div>

      <div class="comparison__column comparison__column--right">
        {blok.right_title && <h3 class="comparison__column-title">{blok.right_title}</h3>}
        <ul class="comparison__list">
          {blok.right_items?.map((item: any) => (
            <li class="comparison__item comparison__item--positive">
              <svg class="comparison__item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              {item.text}
            </li>
          ))}
        </ul>
      </div>
    </div>

    {blok.cta_text && (
      <div class="comparison__cta">
        <a href={ctaHref} class="comparison__cta-link">
          {blok.cta_text}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>
      </div>
    )}
  </div>
</section>

<style>
  .comparison { padding: var(--spacing-24) 0; background: linear-gradient(180deg, var(--color-bg-tertiary) 0%, var(--color-bg-primary) 100%); }
  .comparison__container { max-width: var(--max-width); margin: 0 auto; padding: 0 var(--spacing-6); }
  .comparison__headline { font-size: var(--font-size-4xl); font-weight: var(--font-weight-light); text-align: center; margin-bottom: var(--spacing-12); }
  .comparison__columns { display: grid; grid-template-columns: 1fr 1fr; gap: var(--spacing-8); margin-bottom: var(--spacing-12); }
  .comparison__column { background: var(--color-bg-secondary); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--spacing-8); }
  .comparison__column--left { border-color: rgba(239, 68, 68, 0.3); }
  .comparison__column--right { border-color: rgba(94, 234, 212, 0.3); }
  .comparison__column-title { font-size: var(--font-size-lg); font-weight: var(--font-weight-medium); margin-bottom: var(--spacing-6); padding-bottom: var(--spacing-4); border-bottom: 1px solid var(--color-border); }
  .comparison__column--left .comparison__column-title { color: #ef4444; }
  .comparison__column--right .comparison__column-title { color: var(--color-accent); }
  .comparison__list { list-style: none; display: flex; flex-direction: column; gap: var(--spacing-4); }
  .comparison__item { display: flex; align-items: flex-start; gap: var(--spacing-3); font-size: var(--font-size-sm); color: var(--color-text-secondary); line-height: var(--line-height-relaxed); }
  .comparison__item-icon { width: 18px; height: 18px; flex-shrink: 0; margin-top: 2px; }
  .comparison__item--negative .comparison__item-icon { color: #ef4444; }
  .comparison__item--positive .comparison__item-icon { color: var(--color-accent); }
  .comparison__cta { text-align: center; }
  .comparison__cta-link { display: inline-flex; align-items: center; gap: var(--spacing-2); font-size: var(--font-size-base); font-weight: var(--font-weight-medium); color: var(--color-accent); text-decoration: none; transition: gap var(--transition-fast); }
  .comparison__cta-link:hover { gap: var(--spacing-3); color: var(--color-accent); }
  @media (max-width: 768px) { .comparison__columns { grid-template-columns: 1fr; } }
</style>
