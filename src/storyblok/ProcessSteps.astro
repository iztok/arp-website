---
import { storyblokEditable } from '@storyblok/astro';

interface Props {
  blok: {
    headline?: string;
    supporting_message?: string;
    steps?: any[];
  };
}

const { blok } = Astro.props;
---

<section class="process-steps" {...storyblokEditable(blok)}>
  <div class="process-steps__container">
    {blok.headline && <h2 class="process-steps__headline">{blok.headline}</h2>}

    <div class="process-steps__steps">
      {blok.steps?.map((step: any, index: number) => (
        <div class="process-steps__step" {...storyblokEditable(step)}>
          <div class="process-steps__step-number">{step.number}</div>
          <div class="process-steps__step-content">
            <h3 class="process-steps__step-title">{step.title}</h3>
            <p class="process-steps__step-description">{step.description}</p>
          </div>
          {index < (blok.steps?.length || 0) - 1 && (
            <div class="process-steps__connector">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
              </svg>
            </div>
          )}
        </div>
      ))}
    </div>

    {blok.supporting_message && <p class="process-steps__message">{blok.supporting_message}</p>}
  </div>
</section>

<style>
  .process-steps { padding: var(--spacing-24) 0; background: var(--color-bg-secondary); }
  .process-steps__container { max-width: var(--max-width); margin: 0 auto; padding: 0 var(--spacing-6); }
  .process-steps__headline { font-size: var(--font-size-4xl); font-weight: var(--font-weight-light); text-align: center; margin-bottom: var(--spacing-16); }
  .process-steps__steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--spacing-8); margin-bottom: var(--spacing-12); }
  .process-steps__step { position: relative; background: var(--color-bg-primary); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--spacing-8); text-align: center; }
  .process-steps__step-number { font-size: var(--font-size-4xl); font-weight: var(--font-weight-light); color: var(--color-accent); margin-bottom: var(--spacing-4); opacity: 0.5; }
  .process-steps__step-title { font-size: var(--font-size-xl); font-weight: var(--font-weight-medium); margin-bottom: var(--spacing-4); }
  .process-steps__step-description { font-size: var(--font-size-sm); color: var(--color-text-secondary); line-height: var(--line-height-relaxed); }
  .process-steps__connector { position: absolute; right: -28px; top: 50%; transform: translateY(-50%); width: 24px; height: 24px; color: var(--color-border-light); z-index: 1; }
  .process-steps__message { text-align: center; font-size: var(--font-size-lg); font-style: italic; color: var(--color-text-secondary); max-width: 500px; margin: 0 auto; }
  @media (max-width: 1024px) {
    .process-steps__steps { grid-template-columns: 1fr; gap: var(--spacing-4); }
    .process-steps__connector { display: none; }
  }
</style>
