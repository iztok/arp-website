---
import { storyblokEditable } from '@storyblok/astro';

interface Props {
  blok: {
    headline?: string;
    items?: any[];
  };
}

const { blok } = Astro.props;
---

<section class="manifesto" {...storyblokEditable(blok)}>
  <div class="manifesto__container">
    {blok.headline && <h2 class="manifesto__headline">{blok.headline}</h2>}

    <div class="manifesto__list">
      {blok.items?.map((item: any) => (
        <div class="manifesto__item" {...storyblokEditable(item)}>
          <span class="manifesto__number">{item.number}.</span>
          <div class="manifesto__content">
            <h3 class="manifesto__title">{item.title}</h3>
            <p class="manifesto__description">{item.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .manifesto { padding: var(--spacing-24) 0; background: var(--color-bg-secondary); }
  .manifesto__container { max-width: var(--max-width-narrow); margin: 0 auto; padding: 0 var(--spacing-6); }
  .manifesto__headline { font-size: var(--font-size-4xl); font-weight: var(--font-weight-light); text-align: center; margin-bottom: var(--spacing-12); }
  .manifesto__list { display: flex; flex-direction: column; gap: var(--spacing-8); }
  .manifesto__item { display: flex; gap: var(--spacing-6); padding: var(--spacing-6); background: var(--color-bg-card); border: 1px solid var(--color-border); border-radius: var(--radius-lg); box-shadow: var(--shadow-card); }
  .manifesto__number { font-size: var(--font-size-4xl); font-weight: var(--font-weight-light); color: var(--color-accent); opacity: 0.5; line-height: 1; }
  .manifesto__content { flex: 1; }
  .manifesto__title { font-size: var(--font-size-xl); font-weight: var(--font-weight-medium); margin-bottom: var(--spacing-2); }
  .manifesto__description { font-size: var(--font-size-sm); color: var(--color-text-secondary); line-height: var(--line-height-relaxed); }
</style>
