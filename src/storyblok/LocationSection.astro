---
import { storyblokEditable } from '@storyblok/astro';

interface Props {
  blok: {
    headline?: string;
    content?: string;
  };
}

const { blok } = Astro.props;
---

<section class="location-section" {...storyblokEditable(blok)}>
  <div class="location-section__container">
    <div class="location-section__card">
      <div class="location-section__icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
          <circle cx="12" cy="10" r="3"/>
        </svg>
      </div>
      <div class="location-section__content">
        {blok.headline && <h3 class="location-section__headline">{blok.headline}</h3>}
        {blok.content && <p class="location-section__text">{blok.content}</p>}
      </div>
    </div>
  </div>
</section>

<style>
  .location-section { padding: var(--spacing-16) 0; }
  .location-section__container { max-width: var(--max-width-narrow); margin: 0 auto; padding: 0 var(--spacing-6); }
  .location-section__card { display: flex; gap: var(--spacing-6); align-items: flex-start; background: var(--color-bg-secondary); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--spacing-8); }
  .location-section__icon { width: 48px; height: 48px; background: rgba(94, 234, 212, 0.1); border: 1px solid rgba(94, 234, 212, 0.3); border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; color: var(--color-accent); flex-shrink: 0; }
  .location-section__icon svg { width: 24px; height: 24px; }
  .location-section__content { flex: 1; }
  .location-section__headline { font-size: var(--font-size-lg); font-weight: var(--font-weight-medium); margin-bottom: var(--spacing-2); }
  .location-section__text { font-size: var(--font-size-sm); color: var(--color-text-secondary); line-height: var(--line-height-relaxed); }
</style>
