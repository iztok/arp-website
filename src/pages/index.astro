---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import LogoBar from '../components/LogoBar.astro';
import ValueProposition from '../components/ValueProposition.astro';
import ScrollingCards from '../components/ScrollingCards.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import TabbedDemo from '../components/TabbedDemo.astro';
import ComparisonSection from '../components/ComparisonSection.astro';
import StatsGrid from '../components/StatsGrid.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import BlogPreview from '../components/BlogPreview.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Alodix - Custom software you own"
  description="We build custom business software and deploy it on your infrastructure. You get the source code. No subscriptions, no lock-in."
>
  <Header />

  <!-- Section 1: Hero -->
  <Hero
    eyebrow="We build it. You own it."
    phrases={[
      { useCase: 'CRM', infrastructure: 'your database' },
      { useCase: 'Admin Panel', infrastructure: 'your servers' },
      { useCase: 'Workflow System', infrastructure: 'your infrastructure' },
    ]}
    supportingText="We build custom business software and deploy it on your infrastructure. You get the source code. No subscriptions, no lock-in."
    ctaText="Book a Call"
    ctaHref="/contact"
  />

  <!-- Section 2: Logo Bar -->
  <LogoBar
    headline="Software delivery, not SaaS"
    badges={[
      { label: 'Your Servers' },
      { label: 'Your Code' },
      { label: 'Full Handover' },
      { label: 'Open Source' },
    ]}
    note="For companies that want to own their tools"
  />

  <!-- Section 3: Core Value Proposition -->
  <ValueProposition
    headline="We build. You own."
    copy="Tell us what you need. We design, build, and deploy it on your infrastructure. You get clean, documented source code and full ownership."
    primaryCtaText="See our work"
    primaryCtaHref="https://github.com/alodix"
    secondaryCtaText="Book a call"
    secondaryCtaHref="/contact"
  />

  <!-- Section 4: Platform for Every Use Case -->
  <ScrollingCards
    sectionTitle="What we build"
    cards={[
      {
        category: 'Operations',
        icon: 'gears',
        headline: 'Internal tools that fit your process',
        copy: 'Inventory systems, approval workflows, dashboards. Built around how your team actually works.',
        tagLabel: 'YOUR SYSTEMS',
        tagIcons: ['postgresql', 'mysql', 'api'],
      },
      {
        category: 'Sales & Support',
        icon: 'calculator',
        headline: 'CRMs that match your business',
        copy: 'Customer management, ticketing, reporting. Connected to your existing data sources.',
        tagLabel: 'YOUR DATA',
        tagIcons: ['database', 'chart'],
      },
      {
        category: 'Custom Software',
        icon: 'building',
        headline: 'Whatever you need',
        copy: "If it can be built with Laravel, we can build it. And you'll own every line of code.",
        tagLabel: 'YOUR CODE',
        tagIcons: ['laravel', 'filament', 'code'],
      },
    ]}
  />

  <!-- Section 5: Feature Grid -->
  <FeatureGrid
    headline="How we work"
    features={[
      {
        icon: 'code',
        headline: 'Clean, maintainable code',
        copy: 'Laravel best practices. Well-documented. Any PHP developer can pick it up and extend it.',
      },
      {
        icon: 'connection',
        headline: 'Works with what you have',
        copy: 'We connect to your existing databases, APIs, and systems. No need to migrate anything.',
      },
      {
        icon: 'ai',
        headline: 'AI-accelerated, human-reviewed',
        copy: 'We use AI to move fast. Senior engineers review everything. You get quality at speed.',
      },
      {
        icon: 'dev',
        headline: 'Laravel + Filament stack',
        copy: 'Battle-tested tools with huge communities. Easy to find developers. Easy to maintain.',
      },
      {
        icon: 'shield',
        headline: 'Runs on your servers',
        copy: 'We deploy to your infrastructure. AWS, Azure, on-prem—wherever you need it.',
      },
      {
        icon: 'opensource',
        headline: 'No vendor lock-in',
        copy: 'Standard PHP/Laravel. Your team or any agency can maintain and extend it.',
      },
    ]}
  />

  <!-- Section 6: Three Ways to Build -->
  <TabbedDemo
    sectionTitle="What you get"
    sectionCopy="Complete, working software deployed on your infrastructure. Full source code. Documentation. Training if you need it."
    tabs={[
      {
        id: 'chat',
        label: 'Discovery',
        headline: 'We learn your process',
        copy: 'We start with a call to understand what you need. No generic demos. Real conversation about your specific requirements.',
      },
      {
        id: 'visual',
        label: 'Build',
        headline: 'We build it fast',
        copy: 'Using Laravel and Filament, we build your application. You see progress weekly. Feedback loops are short.',
      },
      {
        id: 'code',
        label: 'Handover',
        headline: 'You own everything',
        copy: 'Full source code. Deployment docs. We train your team if needed. Ongoing support available.',
      },
    ]}
  />

  <!-- Section 7: Anti-Cloud Manifesto -->
  <ComparisonSection
    headline="SaaS vs. ownership"
    leftTitle="Typical SaaS"
    leftItems={[
      'Monthly fees forever',
      'Your data on their servers',
      'Features you pay for but never use',
      'Vendor gets acquired, you scramble',
      'Try exporting your data sometime',
    ]}
    rightTitle="What we do"
    rightItems={[
      'One project fee, you own it',
      'Runs on your infrastructure',
      'Built for exactly what you need',
      'Your code, forever',
      'Standard Laravel—anyone can work on it',
    ]}
    ctaText="Learn more"
    ctaHref="/about-manifesto"
  />

  <!-- Section 8: Customer Results -->
  <StatsGrid
    headline="Numbers"
    stats={[
      {
        value: '4-8',
        label: 'weeks typical delivery',
        company: '',
      },
      {
        value: '€15-50K',
        label: 'typical project range',
        company: '',
      },
      {
        value: '100%',
        label: 'code ownership',
        company: '',
      },
      {
        value: '€0',
        label: 'monthly fees',
        company: '',
      },
    ]}
  />

  <!-- Section 9: How We Work Together -->
  <ProcessSteps
    headline="The process"
    supportingMessage="Simple. Direct. No surprises."
    steps={[
      {
        number: '01',
        title: 'Call',
        description: 'We talk about what you need. 30 minutes. No pitch deck.',
      },
      {
        number: '02',
        title: 'Proposal',
        description: 'Fixed scope, fixed price. You know exactly what you get.',
      },
      {
        number: '03',
        title: 'Build',
        description: 'We build it. Weekly updates. You give feedback.',
      },
      {
        number: '04',
        title: 'Deploy',
        description: 'We deploy to your servers. Hand over the code. Done.',
      },
    ]}
  />

  <!-- Section 10: Blog Preview -->
  <BlogPreview
    headline="From our blog"
    posts={[
      {
        title: 'Why we build on Laravel',
        href: '/blog/why-laravel',
        category: 'Tech',
      },
      {
        title: 'The real cost of SaaS',
        href: '/blog/saas-cost',
        category: 'Business',
      },
      {
        title: 'Code ownership matters',
        href: '/blog/code-ownership',
        category: 'Opinion',
      },
    ]}
  />

  <!-- Section 11: Final CTA -->
  <FinalCTA
    headline="Let's talk"
    subheadline="30-minute call. No pitch. Just conversation."
    primaryCtaText="Book a Call"
    primaryCtaHref="/contact"
    secondaryCtaText="See our code"
    secondaryCtaHref="https://github.com/alodix"
  />

  <Footer />
</BaseLayout>
