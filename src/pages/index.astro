---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import ProblemCards from '../components/ProblemCards.astro';
import SolutionPillars from '../components/SolutionPillars.astro';
import IndustryTeaser from '../components/IndustryTeaser.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import ComparisonSection from '../components/ComparisonSection.astro';
import SovereigntyAdvantage from '../components/SovereigntyAdvantage.astro';
import StatsGrid from '../components/StatsGrid.astro';
import WhatWeBelieve from '../components/WhatWeBelieve.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Alodix - Business software you actually own"
  description="Business software you actually own. Built by a 70+ person engineering team. Your code, your servers, your data — full software and data sovereignty."
>
  <Header />

  <!-- Section 1: Hero -->
  <Hero />

  <!-- Section 2: Trust Bar -->
  <TrustBar />

  <!-- Section 3: The Problem -->
  <ProblemCards />

  <!-- Section 4: The Solution -->
  <SolutionPillars />

  <!-- Section 5: Industry Selector Teaser -->
  <IndustryTeaser />

  <!-- Section 6: How We Work -->
  <FeatureGrid />

  <!-- Section 7: The Process -->
  <ProcessSteps />

  <!-- Section 8: SaaS vs. Ownership -->
  <ComparisonSection />

  <!-- Section 9: The Sovereignty Advantage -->
  <SovereigntyAdvantage />

  <!-- Section 10: Numbers -->
  <StatsGrid />

  <!-- Section 11: What We Believe -->
  <WhatWeBelieve />

  <!-- Section 12: Final CTA -->
  <FinalCTA />

  <Footer />
</BaseLayout>
