---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { businessTypes, industries, getAllBusinessTypeSlugs, getBusinessType, getIndustry } from '../../data/use-cases';
import type { PanelStatus } from '../../data/use-cases';

export const prerender = true;

export function getStaticPaths() {
  return getAllBusinessTypeSlugs().map((slug) => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;
const businessType = getBusinessType(slug);

if (!businessType) {
  return Astro.redirect('/use-cases');
}

const industry = getIndustry(businessType.industrySlug);
const relatedTypes = industry?.businessTypes.filter(bt => bt.slug !== slug) || [];

const statusConfig: Record<PanelStatus, { label: string; class: string; tooltip: string }> = {
  'available': {
    label: 'Available',
    class: 'badge--available',
    tooltip: 'Ready to deploy. Included in your project.',
  },
  'coming-soon': {
    label: 'Coming Soon',
    class: 'badge--coming-soon',
    tooltip: 'In development. Join the early access list.',
  },
  'custom': {
    label: 'Custom Build',
    class: 'badge--custom',
    tooltip: 'We design and build this to your exact requirements.',
  },
};
---

<BaseLayout
  title={`${businessType.name} Software - Alodix`}
  description={businessType.metaDescription}
>
  <Header transparent={false} />

  <section class="bt-hero">
    <div class="bt-hero__container">
      <a href="/use-cases" class="bt-hero__back">← All Industries</a>
      <span class="bt-hero__industry">{businessType.industry}</span>
      <h1 class="bt-hero__headline">{businessType.name}</h1>
      <p class="bt-hero__intro">{businessType.intro}</p>
    </div>
  </section>

  {relatedTypes.length > 0 && (
    <section class="bt-related">
      <div class="bt-related__container">
        <span class="bt-related__label">Also in {businessType.industry}:</span>
        <div class="bt-related__pills">
          {relatedTypes.map((rt) => (
            <a href={`/use-cases/${rt.slug}`} class="bt-related__pill">{rt.name}</a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="bt-panels">
    <div class="bt-panels__container">
      <div class="bt-panels__legend">
        <span class="bt-panels__legend-item">
          <span class="badge badge--available">Available</span>
          <span>Ready to deploy</span>
        </span>
        <span class="bt-panels__legend-item">
          <span class="badge badge--coming-soon">Coming Soon</span>
          <span>In development</span>
        </span>
        <span class="bt-panels__legend-item">
          <span class="badge badge--custom">Custom Build</span>
          <span>Built to spec</span>
        </span>
      </div>

      {businessType.panelCategories.map((category) => (
        <div class="bt-category">
          <h2 class="bt-category__title">{category.name}</h2>
          <div class="bt-category__grid">
            {category.panels.map((panel) => (
              <div class="panel-card">
                <div class="panel-card__header">
                  <h3 class="panel-card__name">{panel.name}</h3>
                  <span class={`badge ${statusConfig[panel.status].class}`} title={statusConfig[panel.status].tooltip}>
                    {statusConfig[panel.status].label}
                  </span>
                </div>
                <p class="panel-card__description">{panel.description}</p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="bt-sovereignty">
    <div class="bt-sovereignty__container">
      <p class="bt-sovereignty__text">
        <strong>Full ownership.</strong> Every panel we build becomes yours—source code, database, deployment. No subscriptions. No lock-in. Your infrastructure, your rules.
      </p>
    </div>
  </section>

  <section class="bt-cta">
    <div class="bt-cta__container">
      <h2 class="bt-cta__headline">Ready to build your {businessType.name.toLowerCase()} software?</h2>
      <p class="bt-cta__text">30-minute call. No pitch. We'll discuss what you need and whether we're a good fit.</p>
      <div class="bt-cta__buttons">
        <a href="/contact" class="btn btn--primary btn--large">Book a Discovery Call</a>
      </div>
      <p class="bt-cta__note">Don't see what you need? We build custom panels too.</p>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  .bt-hero {
    padding: var(--spacing-32) var(--spacing-6) var(--spacing-12);
    background: linear-gradient(180deg, var(--color-bg-primary) 0%, var(--color-bg-secondary) 100%);
  }

  .bt-hero__container {
    max-width: var(--max-width-narrow);
    margin: 0 auto;
  }

  .bt-hero__back {
    display: inline-block;
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    text-decoration: none;
    margin-bottom: var(--spacing-6);
    transition: color var(--transition-fast);
  }

  .bt-hero__back:hover {
    color: var(--color-accent);
  }

  .bt-hero__industry {
    display: block;
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--spacing-2);
  }

  .bt-hero__headline {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: var(--font-weight-light);
    line-height: 1.2;
    margin-bottom: var(--spacing-6);
  }

  .bt-hero__intro {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
  }

  .bt-related {
    padding: var(--spacing-4) var(--spacing-6);
    background: var(--color-bg-secondary);
    border-bottom: 1px solid var(--color-border);
  }

  .bt-related__container {
    max-width: var(--max-width-narrow);
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: var(--spacing-4);
    flex-wrap: wrap;
  }

  .bt-related__label {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .bt-related__pills {
    display: flex;
    gap: var(--spacing-2);
    flex-wrap: wrap;
  }

  .bt-related__pill {
    font-size: var(--font-size-xs);
    padding: var(--spacing-1) var(--spacing-3);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .bt-related__pill:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .bt-panels {
    padding: var(--spacing-12) var(--spacing-6);
  }

  .bt-panels__container {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .bt-panels__legend {
    display: flex;
    gap: var(--spacing-6);
    margin-bottom: var(--spacing-10);
    padding: var(--spacing-4);
    background: var(--color-bg-secondary);
    border-radius: var(--radius-md);
    flex-wrap: wrap;
  }

  .bt-panels__legend-item {
    display: flex;
    align-items: center;
    gap: var(--spacing-2);
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
  }

  .badge {
    display: inline-block;
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }

  .badge--available {
    background: rgba(34, 197, 94, 0.15);
    color: #16a34a;
  }

  .badge--coming-soon {
    background: rgba(234, 179, 8, 0.15);
    color: #ca8a04;
  }

  .badge--custom {
    background: transparent;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
  }

  .bt-category {
    margin-bottom: var(--spacing-10);
  }

  .bt-category__title {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-primary);
    margin-bottom: var(--spacing-4);
    padding-bottom: var(--spacing-2);
    border-bottom: 1px solid var(--color-border);
  }

  .bt-category__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-4);
  }

  .panel-card {
    padding: var(--spacing-5);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .panel-card__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--spacing-3);
    margin-bottom: var(--spacing-2);
  }

  .panel-card__name {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-primary);
    line-height: 1.3;
  }

  .panel-card__description {
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
  }

  .bt-sovereignty {
    padding: var(--spacing-8) var(--spacing-6);
    background: linear-gradient(135deg, rgba(238, 71, 35, 0.05) 0%, rgba(0, 137, 153, 0.05) 100%);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .bt-sovereignty__container {
    max-width: var(--max-width);
    margin: 0 auto;
    text-align: center;
  }

  .bt-sovereignty__text {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
  }

  .bt-sovereignty__text strong {
    color: var(--color-text-primary);
  }

  .bt-cta {
    padding: var(--spacing-16) var(--spacing-6);
    text-align: center;
  }

  .bt-cta__container {
    max-width: var(--max-width-narrow);
    margin: 0 auto;
  }

  .bt-cta__headline {
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-medium);
    margin-bottom: var(--spacing-3);
  }

  .bt-cta__text {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-6);
  }

  .bt-cta__buttons {
    margin-bottom: var(--spacing-4);
  }

  .bt-cta__note {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .bt-category__grid {
      grid-template-columns: 1fr;
    }

    .bt-panels__legend {
      flex-direction: column;
      gap: var(--spacing-3);
    }
  }
</style>
