---
interface Stat {
  value: string;
  label: string;
}

interface Props {
  stats?: Stat[];
}

const {
  stats = [
    {
      value: '4-8 weeks',
      label: 'From first call to production',
    },
    {
      value: '€15-50K',
      label: 'Typical project investment',
    },
    {
      value: '€240K+',
      label: 'Saved over 3 years vs. SaaS alternatives',
    },
    {
      value: 'Zero',
      label: 'Monthly software fees. Ever.',
    },
  ],
} = Astro.props;
---

<section class="stats-grid">
  <div class="stats-grid__container">
    <div class="stats-grid__grid">
      {stats.map((stat) => (
        <div class="stats-grid__card">
          <div class="stats-grid__value">{stat.value}</div>
          <div class="stats-grid__label">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .stats-grid {
    padding: var(--spacing-24) 0;
  }

  .stats-grid__container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--spacing-6);
  }

  .stats-grid__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .stats-grid__card {
    background: var(--color-bg-primary);
    padding: var(--spacing-10);
    text-align: center;
    transition: background-color var(--transition-fast);
  }

  .stats-grid__card:hover {
    background: var(--color-bg-secondary);
  }

  .stats-grid__value {
    font-size: var(--font-size-4xl);
    font-weight: var(--font-weight-light);
    color: var(--color-accent);
    margin-bottom: var(--spacing-3);
  }

  .stats-grid__label {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
  }

  @media (max-width: 1024px) {
    .stats-grid__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .stats-grid__grid {
      grid-template-columns: 1fr;
    }

    .stats-grid__value {
      font-size: var(--font-size-3xl);
    }

    .stats-grid__card {
      padding: var(--spacing-8);
    }
  }
</style>
