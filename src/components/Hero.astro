---
interface TypewriterPhrase {
  useCase: string;
  infrastructure: string;
}

interface Props {
  eyebrow?: string;
  phrases?: TypewriterPhrase[];
  supportingText?: string;
  primaryCtaText?: string;
  primaryCtaHref?: string;
  secondaryCtaText?: string;
  secondaryCtaHref?: string;
}

const {
  eyebrow = 'OPEN SOURCE · SELF-HOSTED · YOURS FOREVER',
  phrases = [
    { useCase: 'client management and sales tools', infrastructure: 'own servers and infrastructure' },
    { useCase: 'helpdesk with smart ticket routing', infrastructure: 'company database and cloud' },
    { useCase: 'hiring pipeline and HR workflows', infrastructure: 'private secure environment' },
    { useCase: 'approval chains and admin systems', infrastructure: 'self-hosted infrastructure' },
  ],
  supportingText = 'Business software you actually own. Built by a 70+ person engineering team on one of the world\'s most proven open-source frameworks. Your code, your servers, your data — full software and data sovereignty.',
  primaryCtaText = 'Book a Discovery Call',
  primaryCtaHref = '/contact',
  secondaryCtaText = 'Find Your Industry',
  secondaryCtaHref = '/use-cases',
} = Astro.props;
---

<section class="hero noise-bg">
  <div class="hero__gradient-orb hero__gradient-orb--1" aria-hidden="true"></div>
  <div class="hero__gradient-orb hero__gradient-orb--2" aria-hidden="true"></div>
  <div class="hero__bg-lines" aria-hidden="true">
    {Array.from({ length: 8 }).map((_, i) => (
      <div class="hero__bg-line" />
    ))}
  </div>

  <div class="hero__container">
    <div class="hero__eyebrow">{eyebrow}</div>

    <h1 class="hero__headline">
      <span class="hero__headline-line">
        <span class="hero__headline-static">Your </span>
        <span class="hero__typewriter-usecase highlight" data-phrases={JSON.stringify(phrases.map(p => p.useCase))}>
          {phrases[0].useCase}
        </span>
      </span>
      <span class="hero__headline-line">
        <span class="hero__headline-static">running on </span>
        <span class="hero__typewriter-infra highlight" data-phrases={JSON.stringify(phrases.map(p => p.infrastructure))}>
          {phrases[0].infrastructure}
        </span>
      </span>
    </h1>

    <p class="hero__supporting-text">{supportingText}</p>

    <div class="hero__cta-wrapper">
      <a href={primaryCtaHref} class="btn btn--primary btn--large hero__cta">
        {primaryCtaText}
      </a>
      <a href={secondaryCtaHref} class="btn btn--outline btn--large hero__cta">
        {secondaryCtaText}
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-32) var(--spacing-6) var(--spacing-24);
    overflow: hidden;
    background: linear-gradient(180deg, var(--color-bg-primary) 0%, var(--color-bg-secondary) 100%);
  }

  .hero__gradient-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
    z-index: 0;
  }

  .hero__gradient-orb--1 {
    top: 10%;
    right: 15%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(238, 71, 35, 0.12) 0%, transparent 70%);
  }

  .hero__gradient-orb--2 {
    bottom: 20%;
    left: 10%;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(0, 137, 153, 0.1) 0%, transparent 70%);
  }

  .hero__bg-lines {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-evenly;
    pointer-events: none;
    opacity: 0.3;
    z-index: 1;
  }

  .hero__bg-line {
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--color-border) 20%,
      var(--color-border) 80%,
      transparent 100%
    );
  }

  .hero__container {
    position: relative;
    z-index: 1;
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }

  .hero__eyebrow {
    display: inline-block;
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-8);
    padding: var(--spacing-2) var(--spacing-4);
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
  }

  .hero__headline {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: var(--font-weight-light);
    line-height: 1.2;
    color: var(--color-text-primary);
    margin-bottom: var(--spacing-8);
  }

  .hero__headline-line {
    display: block;
  }

  .hero__headline-static {
    color: var(--color-text-secondary);
  }

  .hero__typewriter-usecase,
  .hero__typewriter-infra {
    color: var(--color-accent);
    border-bottom: 3px solid var(--color-accent);
    padding-bottom: 2px;
  }

  .hero__supporting-text {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    max-width: 700px;
    margin: 0 auto var(--spacing-10);
    line-height: var(--line-height-relaxed);
  }

  .hero__cta-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-4);
    flex-wrap: wrap;
  }

  .hero__cta {
    min-width: 200px;
  }

  @media (max-width: 768px) {
    .hero {
      padding: var(--spacing-24) var(--spacing-4) var(--spacing-16);
    }

    .hero__headline {
      font-size: clamp(1.5rem, 6vw, 2.25rem);
    }

    .hero__supporting-text {
      font-size: var(--font-size-base);
    }

    .hero__typewriter-usecase,
    .hero__typewriter-infra {
      border-bottom-width: 2px;
    }

    .hero__cta-wrapper {
      flex-direction: column;
    }

    .hero__cta {
      width: 100%;
    }
  }
</style>

<script>
  class SyncedTypewriter {
    private usecaseEl: HTMLElement;
    private infraEl: HTMLElement;
    private usecasePhrases: string[];
    private infraPhrases: string[];
    private currentIndex: number = 0;
    private phase: 'displaying' | 'deleting' | 'typing' = 'displaying';
    private typeSpeed: number = 35;
    private deleteSpeed: number = 20;
    private pauseTime: number = 2500;
    private charIndex: number = 0;

    constructor(usecaseEl: HTMLElement, infraEl: HTMLElement) {
      this.usecaseEl = usecaseEl;
      this.infraEl = infraEl;
      const usecaseAttr = usecaseEl.getAttribute('data-phrases');
      const infraAttr = infraEl.getAttribute('data-phrases');
      this.usecasePhrases = usecaseAttr ? JSON.parse(usecaseAttr) : [];
      this.infraPhrases = infraAttr ? JSON.parse(infraAttr) : [];

      // Start with a pause on the first phrase
      setTimeout(() => this.startDeleting(), this.pauseTime);
    }

    startDeleting() {
      this.phase = 'deleting';
      const currentUseCase = this.usecasePhrases[this.currentIndex];
      const currentInfra = this.infraPhrases[this.currentIndex];
      this.charIndex = Math.max(currentUseCase.length, currentInfra.length);
      this.deleteChar();
    }

    deleteChar() {
      this.charIndex--;
      const currentUseCase = this.usecasePhrases[this.currentIndex];
      const currentInfra = this.infraPhrases[this.currentIndex];

      this.usecaseEl.textContent = currentUseCase.substring(0, Math.min(this.charIndex, currentUseCase.length));
      this.infraEl.textContent = currentInfra.substring(0, Math.min(this.charIndex, currentInfra.length));

      if (this.charIndex <= 0) {
        this.currentIndex = (this.currentIndex + 1) % this.usecasePhrases.length;
        this.charIndex = 0;
        setTimeout(() => this.startTyping(), 300);
      } else {
        setTimeout(() => this.deleteChar(), this.deleteSpeed);
      }
    }

    startTyping() {
      this.phase = 'typing';
      this.charIndex = 0;
      this.typeChar();
    }

    typeChar() {
      this.charIndex++;
      const targetUseCase = this.usecasePhrases[this.currentIndex];
      const targetInfra = this.infraPhrases[this.currentIndex];

      this.usecaseEl.textContent = targetUseCase.substring(0, Math.min(this.charIndex, targetUseCase.length));
      this.infraEl.textContent = targetInfra.substring(0, Math.min(this.charIndex, targetInfra.length));

      const maxLen = Math.max(targetUseCase.length, targetInfra.length);
      if (this.charIndex >= maxLen) {
        setTimeout(() => this.startDeleting(), this.pauseTime);
      } else {
        setTimeout(() => this.typeChar(), this.typeSpeed);
      }
    }
  }

  // Initialize when DOM is ready
  document.addEventListener('DOMContentLoaded', () => {
    const usecaseEl = document.querySelector('.hero__typewriter-usecase') as HTMLElement;
    const infraEl = document.querySelector('.hero__typewriter-infra') as HTMLElement;

    if (usecaseEl && infraEl) {
      new SyncedTypewriter(usecaseEl, infraEl);
    }
  });
</script>
