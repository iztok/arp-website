---
interface Industry {
  label: string;
  slug: string;
}

interface Props {
  headline?: string;
  subhead?: string;
  industries?: Industry[];
  ctaText?: string;
  ctaHref?: string;
}

const {
  headline = 'Built for your industry. Configured for your business.',
  subhead = 'We serve 18 industries with 44 panels covering operations, sales, HR, finance, and more. Find your exact business type and see which panels are ready for you.',
  industries = [
    { label: 'Professional Services', slug: 'professional-services' },
    { label: 'Technology & IT', slug: 'technology-it' },
    { label: 'Manufacturing', slug: 'manufacturing' },
    { label: 'Healthcare & Life Sciences', slug: 'healthcare-life-sciences' },
    { label: 'Financial Services & Insurance', slug: 'financial-services-insurance' },
    { label: 'Retail & E-commerce', slug: 'retail-ecommerce' },
    { label: 'Real Estate & Property', slug: 'real-estate-property' },
    { label: 'Construction & Engineering', slug: 'construction-engineering' },
    { label: 'Logistics & Transportation', slug: 'logistics-transportation' },
    { label: 'Education & Training', slug: 'education-training' },
    { label: 'Hospitality & Tourism', slug: 'hospitality-tourism' },
    { label: 'Media, Marketing & Creative', slug: 'media-marketing-creative' },
    { label: 'Energy & Environment', slug: 'energy-environment' },
    { label: 'Agriculture & Food Production', slug: 'agriculture-food-production' },
    { label: 'Non-Profit & Associations', slug: 'non-profit-associations' },
    { label: 'Government & Public Sector', slug: 'government-public-sector' },
    { label: 'Automotive & Mobility', slug: 'automotive-mobility' },
    { label: 'Recruitment & HR Services', slug: 'recruitment-hr-services' },
  ],
  ctaText = 'Explore All Use Cases',
  ctaHref = '/use-cases',
} = Astro.props;
---

<section class="industry-teaser">
  <div class="industry-teaser__container">
    <h2 class="industry-teaser__headline">{headline}</h2>
    <p class="industry-teaser__subhead">{subhead}</p>

    <div class="industry-teaser__grid">
      {industries.map((industry) => (
        <a href={`${ctaHref}?industry=${industry.slug}`} class="industry-teaser__item">
          {industry.label}
        </a>
      ))}
    </div>

    <div class="industry-teaser__cta">
      <a href={ctaHref} class="btn btn--outline">
        {ctaText}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12 5 19 12 12 19"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .industry-teaser {
    padding: var(--spacing-24) 0;
    background-color: var(--color-bg-secondary);
  }

  .industry-teaser__container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--spacing-6);
    text-align: center;
  }

  .industry-teaser__headline {
    font-size: var(--font-size-4xl);
    font-weight: var(--font-weight-light);
    margin-bottom: var(--spacing-4);
  }

  .industry-teaser__subhead {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    max-width: 700px;
    margin: 0 auto var(--spacing-12);
    line-height: var(--line-height-relaxed);
  }

  .industry-teaser__grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--spacing-3);
    margin-bottom: var(--spacing-12);
  }

  .industry-teaser__item {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-4) var(--spacing-3);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-primary);
    text-decoration: none;
    text-align: center;
    transition: all var(--transition-fast);
    line-height: var(--line-height-snug);
  }

  .industry-teaser__item:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    box-shadow: var(--shadow-sm);
    transform: translateY(-1px);
  }

  .industry-teaser__cta {
    display: flex;
    justify-content: center;
  }

  @media (max-width: 1024px) {
    .industry-teaser__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .industry-teaser__headline {
      font-size: var(--font-size-3xl);
    }

    .industry-teaser__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
