---
interface Feature {
  icon: string;
  headline: string;
  copy: string;
}

interface Props {
  headline?: string;
  features?: Feature[];
}

const {
  headline = 'How we build software that lasts',
  features = [
    {
      icon: 'code',
      headline: 'Clean, maintainable code',
      copy: 'Built on one of the most popular and stable open-source frameworks in the world. Well-documented. Any developer can pick it up and extend it. No proprietary magic.',
    },
    {
      icon: 'connection',
      headline: 'Works with what you have',
      copy: 'We connect to your existing databases, APIs, and systems. Your data stays where it is. No forced migrations, no new dependencies.',
    },
    {
      icon: 'ai',
      headline: 'AI-accelerated, human-reviewed',
      copy: 'We use AI to build faster. Senior engineers review everything. Nothing ships without human sign-off. You get quality at speed.',
    },
    {
      icon: 'shield',
      headline: 'Self-hosted by default',
      copy: 'Deployed on your infrastructure. AWS, Azure, on-prem — wherever your compliance requirements dictate. Your data never touches our servers.',
    },
    {
      icon: 'opensource',
      headline: 'Open source foundation',
      copy: 'The framework is open source. Fork it, extend it, audit it. No black boxes. See exactly what you\'re running.',
    },
    {
      icon: 'lock',
      headline: 'No vendor lock-in. Ever.',
      copy: 'Standard, widely-used technology. Your team or any agency can maintain and extend it. If we disappeared tomorrow, your software keeps running.',
    },
  ],
} = Astro.props;

const iconMap: Record<string, string> = {
  code: '<path d="M16 18l6-6-6-6M8 6l-6 6 6 6"/>',
  connection: '<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>',
  ai: '<path d="M12 2L9 9L2 12L9 15L12 22L15 15L22 12L15 9L12 2Z"/>',
  shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
  opensource: '<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>',
  lock: '<rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>',
};
---

<section class="feature-grid">
  <div class="feature-grid__container">
    <h2 class="feature-grid__headline">{headline}</h2>

    <div class="feature-grid__grid">
      {features.map((feature) => (
        <div class="feature-grid__card">
          <div class="feature-grid__icon">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={iconMap[feature.icon] || iconMap.code}
            />
          </div>
          <h3 class="feature-grid__card-headline">{feature.headline}</h3>
          <p class="feature-grid__card-copy">{feature.copy}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .feature-grid {
    padding: var(--spacing-24) 0;
    background-color: var(--color-bg-primary);
  }

  .feature-grid__container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--spacing-6);
  }

  .feature-grid__headline {
    font-size: var(--font-size-4xl);
    font-weight: var(--font-weight-light);
    text-align: center;
    margin-bottom: var(--spacing-16);
  }

  .feature-grid__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background-color: var(--color-border);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .feature-grid__card {
    background-color: var(--color-bg-card);
    padding: var(--spacing-8);
    transition: all var(--transition-fast);
  }

  .feature-grid__card:hover {
    background-color: var(--color-bg-secondary);
  }

  .feature-grid__icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--spacing-4);
    color: var(--color-accent);
  }

  .feature-grid__icon svg {
    width: 24px;
    height: 24px;
  }

  .feature-grid__card-headline {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-medium);
    margin-bottom: var(--spacing-3);
  }

  .feature-grid__card-copy {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
  }

  @media (max-width: 1024px) {
    .feature-grid__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .feature-grid__grid {
      grid-template-columns: 1fr;
    }

    .feature-grid__headline {
      font-size: var(--font-size-3xl);
    }
  }
</style>
