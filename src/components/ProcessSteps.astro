---
interface Step {
  number: string;
  title: string;
  description: string;
  detail: string;
}

interface Props {
  headline?: string;
  steps?: Step[];
}

const {
  headline = 'From conversation to ownership in three steps',
  steps = [
    {
      number: '01',
      title: 'Discover',
      description: 'We start with a real conversation about your specific requirements. No generic demos, no product tours. We want to understand how your business actually works — then we show you exactly how we\'d build it.',
      detail: '30-minute call. No pitch deck.',
    },
    {
      number: '02',
      title: 'Build',
      description: 'Our 70+ person team designs the architecture and builds your system. AI accelerates development within proven patterns. You see progress weekly and provide feedback continuously.',
      detail: '4-8 weeks typical delivery. Fixed scope, fixed price.',
    },
    {
      number: '03',
      title: 'Own',
      description: 'Deployed on your infrastructure. Full code handover. Training for your team. Ongoing support if you want it — but you\'ll never need our permission to change anything.',
      detail: '100% code ownership. Zero monthly fees.',
    },
  ],
} = Astro.props;
---

<section class="process-steps">
  <div class="process-steps__container">
    <h2 class="process-steps__headline">{headline}</h2>

    <div class="process-steps__steps">
      {steps.map((step, index) => (
        <div class="process-steps__step">
          <div class="process-steps__step-number">{step.number}</div>
          <div class="process-steps__step-content">
            <h3 class="process-steps__step-title">{step.title}</h3>
            <p class="process-steps__step-description">{step.description}</p>
            <p class="process-steps__step-detail">{step.detail}</p>
          </div>
          {index < steps.length - 1 && (
            <div class="process-steps__connector">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
              </svg>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .process-steps {
    padding: var(--spacing-24) 0;
    background: var(--color-bg-secondary);
  }

  .process-steps__container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--spacing-6);
  }

  .process-steps__headline {
    font-size: var(--font-size-4xl);
    font-weight: var(--font-weight-light);
    text-align: center;
    margin-bottom: var(--spacing-16);
  }

  .process-steps__steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-8);
  }

  .process-steps__step {
    position: relative;
    background: var(--color-bg-primary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--spacing-8);
    text-align: center;
  }

  .process-steps__step-number {
    font-size: var(--font-size-4xl);
    font-weight: var(--font-weight-light);
    color: var(--color-accent);
    margin-bottom: var(--spacing-4);
    opacity: 0.5;
  }

  .process-steps__step-title {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-medium);
    margin-bottom: var(--spacing-4);
  }

  .process-steps__step-description {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    margin-bottom: var(--spacing-4);
  }

  .process-steps__step-detail {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.025em;
  }

  .process-steps__connector {
    position: absolute;
    right: -28px;
    top: 50%;
    transform: translateY(-50%);
    width: 24px;
    height: 24px;
    color: var(--color-border-light);
    z-index: 1;
  }

  @media (max-width: 1024px) {
    .process-steps__steps {
      grid-template-columns: 1fr;
      gap: var(--spacing-4);
      max-width: 600px;
      margin: 0 auto;
    }

    .process-steps__connector {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .process-steps__headline {
      font-size: var(--font-size-3xl);
    }
  }
</style>
