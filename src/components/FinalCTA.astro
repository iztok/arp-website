---
interface Props {
  headline?: string;
  subheadline?: string;
  primaryCtaText?: string;
  primaryCtaHref?: string;
  secondaryCtaText?: string;
  secondaryCtaHref?: string;
}

const {
  headline = "It's your turn to own",
  subheadline = 'Stop renting software. Start building assets. Take back sovereignty over your data and your business.',
  primaryCtaText = 'Book a Discovery Call',
  primaryCtaHref = '/contact',
  secondaryCtaText = 'Explore on GitHub',
  secondaryCtaHref = 'https://github.com/arpforge',
} = Astro.props;
---

<section class="final-cta noise-bg">
  <div class="final-cta__container">
    <h2 class="final-cta__headline">{headline}</h2>
    <p class="final-cta__subheadline">{subheadline}</p>

    <div class="final-cta__buttons">
      <a href={primaryCtaHref} class="btn btn--primary btn--large">{primaryCtaText}</a>
      <a href={secondaryCtaHref} class="btn btn--outline btn--large final-cta__btn-outline">{secondaryCtaText}</a>
    </div>
  </div>
</section>

<style>
  .final-cta {
    padding: var(--spacing-24) 0;
    background: linear-gradient(180deg, var(--color-black-petrol) 0%, #021e28 100%);
    color: #FFFFFF;
  }

  .final-cta__container {
    max-width: var(--max-width-narrow);
    margin: 0 auto;
    padding: 0 var(--spacing-6);
    text-align: center;
  }

  .final-cta__headline {
    font-size: var(--font-size-5xl);
    font-weight: var(--font-weight-light);
    color: #FFFFFF;
    margin-bottom: var(--spacing-4);
  }

  .final-cta__subheadline {
    font-size: var(--font-size-xl);
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: var(--spacing-10);
    line-height: var(--line-height-relaxed);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .final-cta__buttons {
    display: flex;
    gap: var(--spacing-4);
    justify-content: center;
    flex-wrap: wrap;
  }

  .final-cta__btn-outline {
    color: #FFFFFF;
    border-color: rgba(255, 255, 255, 0.3);
  }

  .final-cta__btn-outline:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.5);
    color: #FFFFFF;
  }

  @media (max-width: 768px) {
    .final-cta__headline {
      font-size: var(--font-size-3xl);
    }

    .final-cta__buttons {
      flex-direction: column;
      align-items: center;
    }
  }
</style>
