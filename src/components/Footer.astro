---
interface FooterLink {
  label: string;
  href: string;
}

interface FooterColumn {
  title: string;
  links: FooterLink[];
}

interface Props {
  columns?: FooterColumn[];
}

const {
  columns = [
    {
      title: 'Platform',
      links: [
        { label: 'Panels Overview', href: '/platform/panels' },
        { label: 'AI Agents', href: '/platform/ai-agents' },
        { label: 'Self-Hosting', href: '/platform/self-hosting' },
        { label: 'Open Source', href: '/platform/open-source' },
        { label: 'Security', href: '/security' },
      ],
    },
    {
      title: 'Use Cases',
      links: [
        { label: 'By Industry', href: '/use-cases' },
        { label: 'Operations', href: '/use-cases?category=operations' },
        { label: 'Sales & CRM', href: '/use-cases?category=sales' },
        { label: 'HR & People', href: '/use-cases?category=hr' },
        { label: 'Finance & Admin', href: '/use-cases?category=finance' },
      ],
    },
    {
      title: 'Resources',
      links: [
        { label: 'Documentation', href: '/docs' },
        { label: 'GitHub', href: 'https://github.com/arpforge' },
        { label: 'Blog', href: '/blog' },
        { label: 'Anti-Cloud Manifesto', href: '/manifesto' },
      ],
    },
    {
      title: 'Company',
      links: [
        { label: 'About', href: '/about' },
        { label: 'Team', href: '/team' },
        { label: 'Careers', href: '/careers' },
        { label: 'Contact', href: '/contact' },
      ],
    },
  ],
} = Astro.props;

const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__container">
    <div class="footer__main">
      <div class="footer__columns">
        {columns.map((column) => (
          <div class="footer__column">
            <h4 class="footer__column-title">{column.title}</h4>
            <ul class="footer__links">
              {column.links.map((link) => (
                <li>
                  <a href={link.href} class="footer__link">{link.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="footer__bottom">
      <div class="footer__bottom-left">
        <div class="footer__legal-links">
          <a href="/terms" class="footer__legal-link">Terms of Use</a>
          <span class="footer__legal-separator">&middot;</span>
          <a href="/privacy" class="footer__legal-link">Privacy Policy</a>
          <span class="footer__legal-separator">&middot;</span>
          <a href="/security" class="footer__legal-link">Security</a>
        </div>

        <p class="footer__copyright">
          ARPforge &middot; &copy; {currentYear} ARPforge. All rights reserved.
        </p>
      </div>

      <p class="footer__location">
        &#x1F1F8;&#x1F1EE; Built in the EU. For the EU. And beyond.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-black-petrol);
    border-top: none;
    padding: var(--spacing-16) 0 var(--spacing-8);
  }

  .footer__container {
    max-width: var(--max-width-wide);
    margin: 0 auto;
    padding: 0 var(--spacing-6);
  }

  .footer__main {
    padding-bottom: var(--spacing-12);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .footer__columns {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--spacing-8);
  }

  .footer__column-title {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: var(--spacing-4);
  }

  .footer__links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3);
  }

  .footer__link {
    font-size: var(--font-size-sm);
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer__link:hover {
    color: var(--color-flame-red);
  }

  .footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--spacing-8);
    flex-wrap: wrap;
    gap: var(--spacing-4);
  }

  .footer__bottom-left {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
  }

  .footer__legal-links {
    display: flex;
    align-items: center;
    gap: var(--spacing-2);
  }

  .footer__legal-link {
    font-size: var(--font-size-xs);
    color: rgba(255, 255, 255, 0.4);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer__legal-link:hover {
    color: rgba(255, 255, 255, 0.7);
  }

  .footer__legal-separator {
    color: rgba(255, 255, 255, 0.2);
    font-size: var(--font-size-xs);
  }

  .footer__copyright {
    font-size: var(--font-size-sm);
    color: rgba(255, 255, 255, 0.5);
  }

  .footer__location {
    font-size: var(--font-size-sm);
    color: rgba(255, 255, 255, 0.5);
    display: flex;
    align-items: center;
    gap: var(--spacing-2);
  }

  @media (max-width: 1024px) {
    .footer__columns {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .footer__columns {
      grid-template-columns: 1fr;
    }

    .footer__bottom {
      flex-direction: column;
      text-align: center;
    }

    .footer__bottom-left {
      align-items: center;
    }

    .footer__legal-links {
      justify-content: center;
    }
  }
</style>
