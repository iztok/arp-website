---
interface FooterLink {
  label: string;
  href: string;
}

interface FooterColumn {
  title: string;
  links: FooterLink[];
}

interface Props {
  columns?: FooterColumn[];
}

const {
  columns = [
    {
      title: 'Platform',
      links: [
        { label: 'AI Agents', href: '/platform/ai-agents' },
        { label: 'Admin Panels', href: '/platform/admin-panels' },
        { label: 'Workflows', href: '/platform/workflows' },
        { label: 'Self-Hosting', href: '/platform/self-hosting' },
        { label: 'Open Source', href: '/platform/open-source' },
      ],
    },
    {
      title: 'Solutions',
      links: [
        { label: 'Operations', href: '/solutions/operations' },
        { label: 'Finance', href: '/solutions/finance' },
        { label: 'Manufacturing', href: '/solutions/manufacturing' },
        { label: 'Professional Services', href: '/solutions/professional-services' },
        { label: 'Growing Companies', href: '/solutions/growing-companies' },
      ],
    },
    {
      title: 'Resources',
      links: [
        { label: 'Documentation', href: '/docs' },
        { label: 'GitHub', href: 'https://github.com/alodix' },
        { label: 'Blog', href: '/blog' },
        { label: 'Case Studies', href: '/case-studies' },
        { label: 'Anti-Cloud Manifesto', href: '/manifesto' },
      ],
    },
    {
      title: 'Company',
      links: [
        { label: 'About', href: '/about' },
        { label: 'Careers', href: '/careers' },
        { label: 'Contact', href: '/contact' },
        { label: 'Partners', href: '/partners' },
      ],
    },
  ],
} = Astro.props;

const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__container">
    <div class="footer__main">
      <div class="footer__columns">
        {columns.map((column) => (
          <div class="footer__column">
            <h4 class="footer__column-title">{column.title}</h4>
            <ul class="footer__links">
              {column.links.map((link) => (
                <li>
                  <a href={link.href} class="footer__link">{link.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div class="footer__cta-column">
        <a href="/start" class="btn btn--primary footer__cta-btn">Start for free</a>
        <a href="/demo" class="btn btn--outline footer__cta-btn">Book a demo</a>

        <div class="footer__social">
          <a href="https://linkedin.com" class="footer__social-link" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
          <a href="https://twitter.com" class="footer__social-link" aria-label="X (Twitter)">
            <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
          <a href="https://discord.com" class="footer__social-link" aria-label="Discord">
            <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
              <path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"/>
            </svg>
          </a>
        </div>

        <div class="footer__legal-links">
          <a href="/terms" class="footer__legal-link">Terms of Use</a>
          <a href="/privacy" class="footer__legal-link">Privacy Policy</a>
          <a href="/security" class="footer__legal-link">Security</a>
        </div>
      </div>
    </div>

    <div class="footer__bottom">
      <div class="footer__logo">
        <svg width="40" height="40" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="32" height="32" rx="8" fill="var(--color-flame-red)"/>
          <path d="M8 12L16 8L24 12V20L16 24L8 20V12Z" stroke="#FFFFFF" stroke-width="2" fill="none"/>
          <circle cx="16" cy="16" r="3" fill="#FFFFFF"/>
        </svg>
        <span class="footer__logo-text">Alodix</span>
      </div>

      <p class="footer__copyright">
        &copy; {currentYear} Alodix. All rights reserved.
      </p>

      <p class="footer__location">
        <span class="footer__flag">🇸🇮</span> Made in Slovenia
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-black-petrol);
    border-top: none;
    padding: var(--spacing-16) 0 var(--spacing-8);
  }

  .footer__container {
    max-width: var(--max-width-wide);
    margin: 0 auto;
    padding: 0 var(--spacing-6);
  }

  .footer__main {
    display: grid;
    grid-template-columns: 3fr 1fr;
    gap: var(--spacing-16);
    padding-bottom: var(--spacing-12);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .footer__columns {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--spacing-8);
  }

  .footer__column-title {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: var(--spacing-4);
  }

  .footer__links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3);
  }

  .footer__link {
    font-size: var(--font-size-sm);
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer__link:hover {
    color: var(--color-flame-red);
  }

  .footer__cta-column {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3);
  }

  .footer__cta-btn {
    width: 100%;
    justify-content: center;
  }

  .footer__social {
    display: flex;
    gap: var(--spacing-4);
    margin-top: var(--spacing-4);
  }

  .footer__social-link {
    color: rgba(255, 255, 255, 0.5);
    transition: color var(--transition-fast);
  }

  .footer__social-link:hover {
    color: #FFFFFF;
  }

  .footer__legal-links {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
    margin-top: var(--spacing-6);
  }

  .footer__legal-link {
    font-size: var(--font-size-xs);
    color: rgba(255, 255, 255, 0.4);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer__legal-link:hover {
    color: rgba(255, 255, 255, 0.7);
  }

  .footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--spacing-8);
    flex-wrap: wrap;
    gap: var(--spacing-4);
  }

  .footer__logo {
    display: flex;
    align-items: center;
    gap: var(--spacing-3);
    color: #FFFFFF;
  }

  .footer__logo-text {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-semibold);
  }

  .footer__copyright {
    font-size: var(--font-size-sm);
    color: rgba(255, 255, 255, 0.5);
  }

  .footer__location {
    font-size: var(--font-size-sm);
    color: rgba(255, 255, 255, 0.5);
    display: flex;
    align-items: center;
    gap: var(--spacing-2);
  }

  @media (max-width: 1024px) {
    .footer__main {
      grid-template-columns: 1fr;
      gap: var(--spacing-12);
    }

    .footer__columns {
      grid-template-columns: repeat(2, 1fr);
    }

    .footer__cta-column {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
    }

    .footer__cta-btn {
      width: auto;
    }

    .footer__social {
      margin-top: 0;
      margin-left: auto;
    }

    .footer__legal-links {
      flex-direction: row;
      margin-top: 0;
      width: 100%;
    }
  }

  @media (max-width: 640px) {
    .footer__columns {
      grid-template-columns: 1fr;
    }

    .footer__bottom {
      flex-direction: column;
      text-align: center;
    }

    .footer__cta-column {
      flex-direction: column;
    }

    .footer__cta-btn {
      width: 100%;
    }

    .footer__social {
      margin-left: 0;
      justify-content: center;
    }

    .footer__legal-links {
      justify-content: center;
    }
  }
</style>
